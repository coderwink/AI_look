{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xingge.local/schema/look.schema.json",
  "title": "Look（一套搭配）",
  "type": "object",
  "required": ["id", "title", "styles", "scenes", "image", "items", "palette", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^look-[a-z0-9-]+$",
      "description": "唯一 ID，小写字母/数字/连字符，建议 look-001 递增"
    },
    "title": { "type": "string", "minLength": 2, "maxLength": 24, "description": "卡片标题" },
    "summary": { "type": "string", "maxLength": 32, "description": "一句话卖点，卡片副标题" },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "风格 key 数组，取值见 content/taxonomy.json → styles"
    },
    "scenes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "场景 key 数组，取值见 taxonomy.json → scenes"
    },
    "seasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "季节 key 数组，取值见 taxonomy.json → seasons"
    },
    "image": {
      "type": "object",
      "required": ["src", "ratio"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "description": "content/images/looks/ 下的文件名" },
        "ratio": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 2.0,
          "description": "宽/高。瀑布流用它预留高度，避免图片加载时跳动"
        },
        "alt": { "type": "string", "description": "无障碍描述" },
        "credit": { "type": "string", "description": "图片来源" }
      }
    },
    "desc": { "type": "string", "maxLength": 300, "description": "详情页正文" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cat", "name"],
        "additionalProperties": false,
        "properties": {
          "cat": { "type": "string", "description": "品类 key，见 taxonomy.json → itemCategories" },
          "name": { "type": "string", "description": "单品名称" },
          "note": { "type": "string", "description": "版型 / 选购要点" }
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "description": "配色方案，HEX 色值"
    },
    "tip": { "type": "string", "maxLength": 160, "description": "可执行的搭配提醒" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "搜索用标签" },
    "author": { "type": "string", "description": "署名" },
    "status": {
      "type": "string",
      "enum": ["published", "draft"],
      "description": "draft 不会出现在前端"
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
